	measure 'Yield score' = DIVIDE([Market Blended Yield], 0.10, 0) * 0.5
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Price
		lineageTag: 7a2f60e1-b393-4b0b-980d-3193700b373a

	measure 'Speed score' = (1 - DIVIDE([Avg Days on Market], 180, 0)) * 0.3
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Core
		lineageTag: 5e9368cc-c13b-41e0-bcca-111a44edb338

	measure 'Amenity score' = [Amenity Index] * 0.2
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Segment
		lineageTag: 21133c34-dbae-46b0-8100-21bccebdbd84

	measure 'Top Opportunity Driver' =
			
			VAR YS = DIVIDE([Market Blended Yield], 0.10, 0) * 0.5
			VAR DS = (1 - DIVIDE([Avg Days on Market], 180, 0)) * 0.3
			VAR AI = [Amenity Index] * 0.2
			RETURN
			    SWITCH(TRUE(),
			        YS >= DS && YS >= AI, "yield strength (" & FORMAT([Market Blended Yield],"0.0%") & ")",
			        DS >= YS && DS >= AI, "market speed (" & FORMAT([Avg Days on Market],"0") & " days DOM)",
			        "amenity quality (" & FORMAT([Amenity Index],"0.00") & " index)"
			    )
		displayFolder: Market
		lineageTag: 96954972-a4b5-4189-951b-d8b70f3f834f

	measure 'Top Driver Label' =
			
			VAR yieldScore = DIVIDE([Market Blended Yield], 0.10, 0)
			VAR domScore = 1 - DIVIDE([Avg Days on Market], 180, 0)
			VAR amenityScore = [Amenity Index] * 0.2
			
			VAR maxScore = MAX(yieldScore, MAX(domScore, amenityScore))
			
			RETURN
			SWITCH(
			    TRUE(),
			    yieldScore = maxScore, "strong rental yield",
			    domScore = maxScore, "fast market turnover",
			    amenityScore = maxScore, "premium amenities",
			    "balanced factors"
			)
		displayFolder: Titles
		lineageTag: e52c6d0b-ca32-4a21-8e4f-6054e9217365

	measure 'Tooltip Opportunity Insight' =
			
			VAR country = SELECTEDVALUE(DimLocation[Country-City])
			VAR oppScore = [Opportunity Score]
			VAR yield = [Market Blended Yield]
			VAR dom = [Avg Days on Market]
			VAR driver = [Top Driver Label]
			
			RETURN
			country & " scores " & FORMAT(oppScore, "0.00%") &
			" — driven primarily by " & driver &
			", with " & FORMAT(yield, "0.00%") &
			" yield and " & FORMAT(dom, "0") &
			" days avg day on market"
		displayFolder: Titles
		lineageTag: 408e3021-4d88-4b1c-a709-df2787ec5b0e

	measure 'Property Insight' =
			
			VAR propid = SELECTEDVALUE(FactEURealEstateDataset[property_id])
			VAR PropType = SELECTEDVALUE(DimPropImage[property_type])
			VAR City = SELECTEDVALUE(DimLocation[Country-City])
			VAR SQM = SELECTEDVALUE(FactEURealEstateDataset[square_meters])
			VAR PpSQM = SELECTEDVALUE(FactEURealEstateDataset[price_per_sqm])
			VAR DOM = SELECTEDVALUE(FactEURealEstateDataset[days_on_market])
			VAR Score = [Opportunity Score]
			VAR DOMNote = IF(DOM<=30, " — among the fastest-moving stock in this category.", IF(DOM>60, " — slow-absorbing; potential negotiation leverage.", "."))
			VAR ScoreNote = IF(Score>=0.7, " High-opportunity tier.", IF(Score>=0.5, " Watch tier.", " Monitor for pricing adjustment."))
			RETURN
			    propid & " is a " & PropType & " building located in " & City & " spanning " & SQM & "m² at €" & FORMAT(PpSQM,"#,##0") & "/m² · Listed for " & DOM & " days" & DOMNote & " Opportunity score: " & FORMAT(Score,"0.00%") & "." & ScoreNote
		displayFolder: Insights
		lineageTag: 4369f0b1-e3b7-430a-bd33-ce493fe42666

