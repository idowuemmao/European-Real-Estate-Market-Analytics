	measure 'Tooltip title' = SELECTEDVALUE(DimLocation[Country-City], "EU Market") & " Market snapshot · "
		displayFolder: Titles
		lineageTag: 41784326-ad60-40e4-b861-527a7b2a6bcd

	measure 'Tooltip Property Insight' = ```
			
			VAR propertyType = SELECTEDVALUE(FactEURealEstateDataset[property_type])
			VAR country = SELECTEDVALUE(DimLocation[country])
			VAR avgSize = [Avg Square Meters]
			VAR priceSQM = [Avg Price Per SQM]
			VAR Country_Avg_Price_Per_SQM = 
			CALCULATE(
			    [Avg Price Per SQM],
			    REMOVEFILTERS(DimLocation[country])
			)
			VAR diffPct =
			DIVIDE(
			    [Avg Price Per SQM] - Country_Avg_Price_Per_SQM,
			    Country_Avg_Price_Per_SQM
			)
			VAR direction = 
			IF(
			    diffPct >= 0,
			    "above",
			    "below"
			)
			RETURN
			country &
			" averages " & FORMAT(avgSize, "#,##") & "m² at €" &
			FORMAT(priceSQM, "#,##") & "/m² — " &
			direction & " the country average by " &
			FORMAT(ABS(diffPct), "0.0%")
			```
		displayFolder: Titles
		lineageTag: 72a4bdde-4b38-4886-b737-39dd4293d851

	measure 'Building Age title' = FORMAT([Avg Building Age], "#,##") & "yrs"
		displayFolder: Core
		lineageTag: 4be590f6-4da9-47b3-b249-253252121bb4

	measure 'Selected KPI YoY%' = ```
			
				VAR __PREV_YEAR =
					CALCULATE(
						[Selected KPI Value (Index)],
						DATEADD('DimDate'[listing_date], -1, YEAR)
					)
				RETURN
					DIVIDE([Selected KPI Value (Index)] - __PREV_YEAR, __PREV_YEAR)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: a2a2b71e-0888-4aaa-a34c-b0a0544201ac

	measure 'Selected Filter 1' = ```
			
			VAR Bedroom_bucket = 
			    IF (
			        ISFILTERED(FactEURealEstateDataset[Bedroom Bucket]),
			        IF(
			            COUNTROWS(VALUES(FactEURealEstateDataset[Bedroom Bucket])) = 0,
			            "N/A",
			            CONCATENATEX(
			                VALUES(FactEURealEstateDataset[Bedroom Bucket]),
			                FactEURealEstateDataset[Bedroom Bucket],
			                ", ",
			                FactEURealEstateDataset[Bedroom Bucket],
			                ASC
			            )
			        ),
			        "All"
			    )
			
			VAR Building_decade = 
			    IF (
			        ISFILTERED(FactEURealEstateDataset[Building Decade]),
			        IF(
			            COUNTROWS(VALUES(FactEURealEstateDataset[Building Decade])) = 0,
			            "N/A",
			            CONCATENATEX(
			                VALUES(FactEURealEstateDataset[Building Decade]),
			                FactEURealEstateDataset[Building Decade],
			                ", ",
			                FactEURealEstateDataset[Building Decade],
			                ASC
			            )
			        ),
			        "All"
			    )
			
			VAR dom = 
			    IF (
			        ISFILTERED(FactEURealEstateDataset[DOM Bucket]),
			        IF(
			            COUNTROWS(VALUES(FactEURealEstateDataset[DOM Bucket])) = 0,
			            "N/A",
			            CONCATENATEX(
			                VALUES(FactEURealEstateDataset[DOM Bucket]),
			                FactEURealEstateDataset[DOM Bucket],
			                ", ",
			                FactEURealEstateDataset[DOM Bucket],
			                ASC
			            )
			        ),
			        "All"
