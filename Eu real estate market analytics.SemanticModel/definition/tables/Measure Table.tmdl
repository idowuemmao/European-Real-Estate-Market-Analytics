	measure 'Color prop_type' = ```
			
			VAR currentValue = [Selected KPI Value (Index)]
			
			VAR maxValue =
			    CALCULATE(
			        MAXX(
			            VALUES(FactEURealEstateDataset[property_type]),
			            [Selected KPI Value (Index)]
			        ),
			        REMOVEFILTERS(FactEURealEstateDataset[property_type])
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    currentValue < 0, "#CD4C46",          
			    currentValue = maxValue, "#0E7C86",
			    "#FFFFFF"                             
			)
			```
		displayFolder: Colors
		lineageTag: fb57f8d1-d24b-43cd-bafc-5c83b06cc22e

	measure 'Color date' = ```
			
			VAR currentValue = [Selected KPI Value (Index)]
			
			VAR maxValue =
			    CALCULATE(
			        MAXX(
			            VALUES(FactEURealEstateDataset[listing_date]),
			            [Selected KPI Value (Index)]
			        ),
			        REMOVEFILTERS(FactEURealEstateDataset[listing_date])
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    currentValue < 0, "#CD4C46",          
			    currentValue = maxValue, "#0E7C86",
			    "#FFFFFF"                             
			)
			```
		displayFolder: Colors
		lineageTag: 1570c6eb-395b-44ed-af37-496da976996f

	measure 'Rent/sales value' =
			
			IF(SELECTEDVALUE(FactEURealEstateDataset[listing_type]) = "Rental" ,
			FORMAT([Avg Monthly Rent EUR], "€ #,##") & "/mon",
			 FORMAT([Avg Sale Price EUR], "€ #,##"))
		displayFolder: Price
		lineageTag: 255a6d92-0dac-46fa-903d-f952709349f3

	measure 'Title 6' = UPPER(SELECTEDVALUE(FactEURealEstateDataset[listing_type])) & " LISTING - PROPERTY DEEP DIVE"
		displayFolder: Titles
		lineageTag: 3783e9cb-ac53-46f5-bd3f-9a1a05c1cb6b

	partition 'Measure Table' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

